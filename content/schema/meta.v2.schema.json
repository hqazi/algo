{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": { "type": "number", "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "source": { "type": "string", "enum": ["curated", "generated", "pasted", "imported"] },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "paste" },
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "license": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string", "minLength": 1 }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "const": "open-set" },
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "license": { "type": "string", "minLength": 1 },
            "attribution": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "name", "url", "license", "attribution"],
          "additionalProperties": false
        }
      ]
    },
    "content_version": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expected_complexity": {
      "type": "object",
      "properties": {
        "time": { "type": "string", "minLength": 1 },
        "space": { "type": "string", "minLength": 1 }
      },
      "required": ["time", "space"],
      "additionalProperties": false
    },
    "compare": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["exact", "unordered", "unordered_deep"] }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "const": "float" },
            "tolerance": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      ]
    },
    "time_limit_ms": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "signature": {
      "type": "object",
      "properties": {
        "function": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
              "type": { "type": "string" }
            },
            "required": ["name", "type"],
            "additionalProperties": false
          }
        },
        "returns": { "type": "string" }
      },
      "required": ["function", "params", "returns"],
      "additionalProperties": false
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "enum": ["python", "rust", "go"] }
    }
  },
  "required": [
    "schema_version",
    "slug",
    "title",
    "topic",
    "difficulty",
    "source",
    "content_version",
    "expected_complexity",
    "compare",
    "time_limit_ms",
    "signature",
    "languages"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/hqazi/algorithm-tutor/blob/main/content/schema/meta.v2.schema.json",
  "title": "Algorithm Tutor problem meta.json (v2)"
}
