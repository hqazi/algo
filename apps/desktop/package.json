{
  "name": "@algorithm-tutor/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Algorithm Tutor desktop app (Electron).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "check:exec-host": "electron-vite build && electron out/main/exec-check.js",
    "check:fuses": "tsx packaging/fuses.ts --check",
    "check:security": "electron-vite build && electron out/main/security-check.js",
    "check:storage": "electron-vite build && electron out/main/storage-check.js",
    "e2e": "electron-vite build && tsx e2e/practice.e2e.ts && tsx e2e/tutor.e2e.ts"
  },
  "dependencies": {
    "@algorithm-tutor/core": "*",
    "@anthropic-ai/sdk": "1.5.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@replit/codemirror-emacs": "6.1.0",
    "@replit/codemirror-vim": "6.3.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "marked": "18.1.3",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "vite": "8.3.8"
  }
}
