{
  "name": "@algo/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Algo desktop app (Electron).",
  "author": {
    "name": "Algo authors",
    "url": "https://github.com/hqazi/algo"
  },
  "homepage": "https://github.com/hqazi/algo",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "check:exec-host": "electron-vite build && electron out/main/exec-check.js",
    "check:fuses": "tsx packaging/fuses.ts --check",
    "check:security": "electron-vite build && electron out/main/security-check.js",
    "check:storage": "electron-vite build && electron out/main/storage-check.js",
    "e2e": "electron-vite build && tsx e2e/v1.e2e.ts && tsx e2e/practice.e2e.ts && tsx e2e/tutor.e2e.ts && tsx e2e/settings.e2e.ts && tsx e2e/intake.e2e.ts && tsx e2e/library.e2e.ts",
    "e2e:claude-code": "electron-vite build && tsx e2e/claude-code.e2e.ts",
    "screenshots": "electron-vite build && tsx e2e/screenshots.ts",
    "package": "electron-vite build && tsx packaging/package.ts",
    "package:dir": "electron-vite build && tsx packaging/package.ts --dir"
  },
  "devDependencies": {
    "@algo/core": "*",
    "@anthropic-ai/sdk": "1.5.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@replit/codemirror-emacs": "6.1.0",
    "@replit/codemirror-vim": "6.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "lucide-react": "1.69.0",
    "marked": "18.1.3",
    "playwright-core": "1.64.1",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6",
    "zod": "4.6.7"
  }
}
