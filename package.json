{
  "name": "algorithm-tutor",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop app for practising data structures and algorithms with an AI tutor.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "packages/core",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "package": "npm run package --workspace apps/desktop --",
    "package:dir": "npm run package:dir --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:exec-host": "npm run check:exec-host --workspace apps/desktop --",
    "check:security": "npm run check:security --workspace apps/desktop --",
    "check:storage": "npm run check:storage --workspace apps/desktop",
    "check:fuses": "npm run check:fuses --workspace apps/desktop",
    "schema:export": "tsx scripts/export-schemas.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:harnesses": "tsx scripts/check-harnesses.ts",
    "e2e": "npm run e2e --workspace apps/desktop --",
    "e2e:claude-code": "npm run e2e:claude-code --workspace apps/desktop --",
    "screenshots": "npm run screenshots --workspace apps/desktop --",
    "smoke:ai": "tsx apps/desktop/scripts/smoke-ai.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
