{
  "schema_version": 2,
  "tests": [
    {
      "id": "example-1",
      "visibility": "visible",
      "category": "example",
      "input": {
        "words": ["a", "bb", "c", "dd", "eee"]
      },
      "expected": {
        "1": ["a", "c"],
        "2": ["bb", "dd"],
        "3": ["eee"]
      }
    },
    {
      "id": "example-2",
      "visibility": "visible",
      "category": "example",
      "input": {
        "words": []
      },
      "expected": {}
    },
    {
      "id": "hidden-3",
      "visibility": "hidden",
      "category": "unicode",
      "input": {
        "words": ["é", "ü", "日本", "\"q\"", "a\\b"]
      },
      "expected": {
        "1": ["é", "ü"],
        "2": ["日本"],
        "3": ["\"q\"", "a\\b"]
      }
    },
    {
      "id": "hidden-4",
      "visibility": "hidden",
      "category": "empty string",
      "input": {
        "words": ["", "x", ""]
      },
      "expected": {
        "0": ["", ""],
        "1": ["x"]
      }
    },
    {
      "id": "hidden-5",
      "visibility": "hidden",
      "category": "one group",
      "input": {
        "words": ["ab", "cd", "ef"]
      },
      "expected": {
        "2": ["ab", "cd", "ef"]
      }
    }
  ]
}
